<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Developer ID + Hardened Runtime のみ有効。研究用 ad-hoc（--options runtime なし）では適用されない。 -->
    <!-- sknw → numba → llvmlite が JIT 実行メモリを確保する。allow-jit=false だと
         瀧澤型（ログイン後 Connection Error）: LLVMPY_TryAllocateExecutableMemory → SIGKILL -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- PyInstaller / Python .so / llvmlite の W^X 緩和。allow-jit とセットで Developer ID 向け -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <!-- サードパーティ .dylib (opencv, numpy) をロードするために必要 -->
    <true/>

    <!-- ファイルアクセス: OCTA画像の読み書きに必要 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- ネットワーク: Streamlit ローカルサーバー用 -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
