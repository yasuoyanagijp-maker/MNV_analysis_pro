  },
  "weights": {
    "U_cv": 0.75,
    "U_dil": 0.25
  },
  "score_formula": "U_cv = piecewise(−NV_CV; neg_nv_cv min/median/max); U_dil = piecewise(−Dilated%; neg_dilated_pct min/median/max); Score = clip(0.75·U_cv + 0.25·U_dil, 0, 100). Soft twin: U = 50 + 50·tanh((median − x) / std) per axis, same weights.",
  "app_feature_keys": {
    "nv_cv": {
      "internal": "cv_diameter",
      "csv_column": "NV Diameter (CV)"
    },
    "dilated_pct": {
