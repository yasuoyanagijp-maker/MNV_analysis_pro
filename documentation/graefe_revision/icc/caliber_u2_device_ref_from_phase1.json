      "small": 11,
      "large": 49,
      "small_3mm": 30
    },
    "header_cohort_n": {
      "small": 33,
      "large": 49,
      "small_3mm": 30,
      "total": 112
    },
    "note": "Log small section incomplete (11/33 images); large and small_3mm complete. Log cannot supply U2 axes."
  },
  "source_batches": {
    "small": "documentation/graefe_revision/data/MNV_batch_20260220_083448small.csv",
    "large": "documentation/graefe_revision/data/MNV_batch_20260220_230245_large.csv",
    "small_3mm": "documentation/graefe_revision/data/MNV_batch_20260220_223647_small_3mm.csv"
